{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.Vasilispapg/claude-handoff",
  "description": "Session handoff for Claude Code: list sessions and build handoff docs another agent continues from.",
  "repository": {
    "url": "https://github.com/Vasilispapg/claude-handoff",
    "source": "github"
  },
  "version": "0.13.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "claude-handoff",
      "version": "0.13.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp",
          "description": "run claude-handoff as an MCP server over stdio"
        }
      ]
    }
  ]
}
